{
	"name": "Ingst-1",
	"properties": {
		"activities": [
			{
				"name": "Copy_nup",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "Bookings"
					},
					{
						"name": "Destination",
						"value": "BOOKING.BOOK"
					}
				],
				"typeProperties": {
					"source": {
						"type": "CosmosDbSqlApiSource",
						"preferredRegions": []
					},
					"sink": {
						"type": "SnowflakeV2Sink",
						"importSettings": {
							"type": "SnowflakeImportCopyCommand"
						}
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "adls_stg",
							"type": "LinkedServiceReference"
						}
					},
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['id']"
								},
								"sink": {
									"name": "ID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['booking_id']"
								},
								"sink": {
									"name": "BOOKING_ID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['property_id']"
								},
								"sink": {
									"name": "PROPERTY_ID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['customer_id']"
								},
								"sink": {
									"name": "CUSTOMER_ID",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "$['owner_id']"
								},
								"sink": {
									"name": "OWNER_ID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['check_in_date']"
								},
								"sink": {
									"name": "CHECK_IN_DATE",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['check_out_date']"
								},
								"sink": {
									"name": "CHECK_OUT_DATE",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['booking_date']"
								},
								"sink": {
									"name": "BOOKING_DATE",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['amount']"
								},
								"sink": {
									"name": "AMOUNT",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "$['currency']"
								},
								"sink": {
									"name": "CURRENCY",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['property_location']['city']"
								},
								"sink": {
									"name": "PROPERTY_LOCATION",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['property_location']['country']"
								},
								"sink": {
									"name": "PROPERTY_LOCATION",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['timestamp']"
								},
								"sink": {
									"name": "TIMESTAMP",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['_rid']"
								},
								"sink": {
									"name": "_RID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['_self']"
								},
								"sink": {
									"name": "_SELF",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['_etag']"
								},
								"sink": {
									"name": "_ETAG",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['_attachments']"
								},
								"sink": {
									"name": "_ATTACHMENTS",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['_ts']"
								},
								"sink": {
									"name": "_TS",
									"type": "Decimal"
								}
							}
						],
						"mapComplexValuesToString": true
					}
				},
				"inputs": [
					{
						"referenceName": "SourceDataset_nup",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DestinationDataset_nup",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}